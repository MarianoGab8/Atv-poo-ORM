import java.sql.SQLException;
import java.util.List;

import com.j256.ormlite.dao.Dao;
import com.j256.ormlite.dao.DaoManager;
import com.j256.ormlite.jdbc.JdbcConnectionSource;
import com.j256.ormlite.support.ConnectionSource;
import com.j256.ormlite.table.TableUtils;

public class QuadradoRepository {

    private Database database;
    private ConnectionSource connection;
    private Dao<Quadrado, Integer> dao;

    public QuadradoRepository() throws SQLException {
        database = new Database("quadrados.db");
        connection = database.getConnection();

        TableUtils.createTableIfNotExists(
            connection, Quadrado.class
        );

        dao = DaoManager.createDao(
            connection, Quadrado.class
        );
    }

    public void cadastrar(Quadrado quadrado)
            throws SQLException {
        dao.create(quadrado);
    }

    public Quadrado buscarPorId(int id)
            throws SQLException {
        return dao.queryForId(id);
    }

    public List<Quadrado> listarTodos()
            throws SQLException {
        return dao.queryForAll();
    }

    public void atualizar(Quadrado quadrado)
            throws SQLException {
        dao.update(quadrado);
    }

    public void excluir(Quadrado quadrado)
            throws SQLException {
        dao.delete(quadrado);
    }
    
    public void excluirTodos() throws SQLException {
    List<Quadrado> quadrados = dao.queryForAll();
    dao.delete(quadrados);
    }

    public void fechar() {
        database.close();
    }
}
